@model LoginViewModel
@{
    ViewData["Title"] = "Prijava";
    Layout = "_LayoutPrazan";
}

<div class="d-flex justify-content-center align-items-center login-wrapper">
    <div class="card shadow-sm login-card">
        <div class="card-body p-4">
            <h1 class="h4 mb-1">Planiranje proizvodnje PVC stolarije</h1>
            <p class="text-muted mb-4">Prijavite se da biste nastavili</p>

            <form asp-controller="Nalog" asp-action="Prijava" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="KorisnickoIme" class="form-label"></label>
                    <input asp-for="KorisnickoIme" class="form-control" autofocus />
                    <span asp-validation-for="KorisnickoIme" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Lozinka" class="form-label"></label>
                    <input asp-for="Lozinka" class="form-control" />
                    <span asp-validation-for="Lozinka" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">Prijavi se</button>
            </form>

            <p class="text-muted small mt-3 mb-0">
                Test nalozi (Deo 1 - seed podaci): <code>referent1</code> / <code>rukovodilac1</code>
                <br />napomena: lozinke iz seed skripte su placeholder - postavi ih preko registracije/ručno pre testiranja.
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
